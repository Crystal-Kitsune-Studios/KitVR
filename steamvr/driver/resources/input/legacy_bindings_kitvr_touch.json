{
  "controller_type": "kitvr_touch",
  "name": "KitVR Touch Legacy Bindings",
  "description": "Default mapping for legacy OpenVR applications.",
  "bindings": {
    "/actions/legacy": {
      "poses": [
        { "output": "/actions/legacy/in/Left_Pose", "path": "/user/hand/left/pose/raw" },
        { "output": "/actions/legacy/in/Right_Pose", "path": "/user/hand/right/pose/raw" }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/trigger", "mode": "trigger",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_axis1_press" },
            "pull": { "output": "/actions/legacy/in/left_axis1_value" }
          }
        },
        {
          "path": "/user/hand/right/input/trigger", "mode": "trigger",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_axis1_press" },
            "pull": { "output": "/actions/legacy/in/right_axis1_value" }
          }
        },
        {
          "path": "/user/hand/left/input/joystick", "mode": "joystick",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_axis0_press" },
            "position": { "output": "/actions/legacy/in/left_axis0_value" }
          }
        },
        {
          "path": "/user/hand/right/input/joystick", "mode": "joystick",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_axis0_press" },
            "position": { "output": "/actions/legacy/in/right_axis0_value" }
          }
        },
        {
          "path": "/user/hand/left/input/grip", "mode": "trigger",
          "inputs": {
            "click": { "output": "/actions/legacy/in/left_grip_press" },
            "pull": { "output": "/actions/legacy/in/left_axis2_value1" }
          }
        },
        {
          "path": "/user/hand/right/input/grip", "mode": "trigger",
          "inputs": {
            "click": { "output": "/actions/legacy/in/right_grip_press" },
            "pull": { "output": "/actions/legacy/in/right_axis2_value1" }
          }
        },
        {
          "path": "/user/hand/left/input/primary", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/left_a_press" } }
        },
        {
          "path": "/user/hand/right/input/primary", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/right_a_press" } }
        },
        {
          "path": "/user/hand/left/input/secondary", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/left_applicationmenu_press" } }
        },
        {
          "path": "/user/hand/right/input/secondary", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/right_applicationmenu_press" } }
        },
        {
          "path": "/user/hand/left/input/menu", "mode": "button",
          "inputs": { "click": { "output": "/actions/legacy/in/left_applicationmenu_press" } }
        }
      ]
    }
  },
  "options": { "simulated_controller_type": "oculus_touch", "simulate_rendermodel": true }
}
