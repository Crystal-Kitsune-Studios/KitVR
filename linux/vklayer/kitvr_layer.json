{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_CKS_kitvr",
    "type": "GLOBAL",
    "library_path": "./libkitvr_layer.so",
    "api_version": "1.1.0",
    "implementation_version": "1",
    "description": "KitVR SteamVR frame capture (publishes to shared memory)",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "instance_extensions": [
      { "name": "VK_KHR_external_memory_capabilities", "spec_version": "1" }
    ],
    "device_extensions": [
      { "name": "VK_KHR_swapchain", "spec_version": "70" }
    ],
    "enable_environment": {
      "KITVR_STEAMVR_LAYER_ENABLE": "1"
    },
    "disable_environment": {
      "DISABLE_KITVR_STEAMVR_LAYER": "1"
    }
  }
}
